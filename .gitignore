*.py[cod]
*$py.class
.venv/
venv/
build/
dist/
*.egg-info/
.eggs/

# ========== tool caches ==========
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/
.tilelang/
tilelang_cache/

# ========== macOS / editors ==========
.DS_Store
._*
.ipynb_checkpoints/
.vscode/
.idea/

# ========== artifacts / binaries / logs ==========
# *.npy: generated eval shards / byte tables (rebuild with tools/make_eval_slices.py)
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.log
*.jsonl
*.npy
nohup.out

# ========== third-party bundles / assets (not redistributed) ==========
/assets/

# ========== local secrets (never commit) ==========
.env
.env.*
*.env
.autodl_token
.autodl_actions.jsonl
**/.autodl_token
*_token
*.pem
*.key
id_rsa*
id_ed25519*
.netrc
.pgpass
infra-refs/
.release_audit/

