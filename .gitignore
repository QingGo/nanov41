# ========== Python / build artifacts ==========
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
build/
dist/
*.egg-info/
.eggs/

# ========== tool caches ==========
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/
.tilelang/
tilelang_cache/

# ========== macOS / editors ==========
.DS_Store
._*
.ipynb_checkpoints/
.vscode/
.idea/

# ========== artifacts / binaries / logs ==========
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.log
*.jsonl
nohup.out

# ========== local secrets (never commit) ==========
.env
.env.*
*.env
.autodl_token
.autodl_actions.jsonl
**/.autodl_token
*_token
*.pem
*.key
id_rsa*
id_ed25519*
.netrc
.pgpass
infra-refs/
.release_audit/

# ========== experiment output: keep curated evidence only ==========
/runs/*
!/runs/README.md
!/runs/p0_b8.json
!/runs/p1_b16_s512.json
!/runs/p0_b8_5090_rerun_2026-10-28.json
!/runs/tl_kernels_5090_2026-10-28.json
!/runs/parity_cuda_fp32_5090.log
!/runs/parity_cuda_bf16_5090.log
!/runs/r42_best_final.json
!/runs/r48_best_b16.json
!/runs/r50_base.json
!/runs/r50_best_b16.json
!/runs/r50_best_b8.json
!/runs/r50_fp8.json
!/runs/r51_fp4_expert_microbench_5090.json

# ========== internal / one-off material: default ignored, whitelist only ==========
# Development docs: milestones, experiment notes, ops runbooks are internal by default.
# Only explicitly whitelisted docs are version-controlled.
/docs/**
!/docs/README.md
!/docs/architecture.md
!/docs/benchmarks.md
!/docs/v41-scaling-check.md

# Internal ops tooling (cloud enable/disable, SSH sync) is not part of the public release.
/tools/**
!/tools/README.md
!/tools/make_patched_ref.py
!/tools/ab_bench.py
!/tools/mfu_accounting.py
!/tools/v41_scaling_check.py

# One-off kernel/benchmark experiments (default ignored; curated packages are whitelisted).
/tl_kernels/
/experiments/*
!/experiments/README.md
!/experiments/tl_kernels/
