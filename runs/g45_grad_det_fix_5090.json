 "fix": {
  "code": [
   "nanov41/chunked_prefill.py: start_pos>0 window KV is returned in absolute position order (de-rotated ring): cat([last win-1 keys, chunk keys]); query i attends to rows i..i+win-1 and topk window part is i+c",
   "nanov41/fast_attn.py: _band_plan(right=True) + sparse_attn_fast(win_hint, right_band) recognize that layout; _check_right_band validates it once per shape",
   "chunked_prefill.install() wraps M.sparse_attn and routes the published window width straight to fast_attn (bypassing v2, which only supports the standard band)"
  ],
  "knob": "NANOV41_CHUNK_ATTN=fast (default) | ref (old rotated-ring + reference fallback, for A/B)",
  "layout_note": "window rows are absolute positions start-win+1 ... start+seqlen-1; row r maps to absolute position start-win+1+r"
 },
